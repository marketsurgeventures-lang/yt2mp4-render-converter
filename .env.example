MSVCR_ENABLED=0
WORDPRESS_ORIGIN=https://your-wordpress-domain.example
MSVCR_SHARED_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_LOWERCASE_HEX_SECRET
